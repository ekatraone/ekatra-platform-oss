{
  "name": "@ekatra/delivery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./certificates": { "types": "./dist/services/certificateService.d.ts", "import": "./dist/services/certificateService.js" },
    "./logger": { "types": "./dist/lib/logger.d.ts", "import": "./dist/lib/logger.js" },
    "./models": { "types": "./dist/lib/modelRouter.d.ts", "import": "./dist/lib/modelRouter.js" },
    "./formatter": { "types": "./dist/lib/whatsappFormatter.d.ts", "import": "./dist/lib/whatsappFormatter.js" },
    "./configuration": { "types": "./dist/configuration.d.ts", "import": "./dist/configuration.js" }
  },
  "scripts": { "build": "tsc", "typecheck": "tsc --noEmit", "test": "node --import tsx --test src/__tests__/*.test.ts" },
  "dependencies": {
    "@ekatra/database": "workspace:*",
    "@ekatra/messaging": "workspace:*",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pdfkit": "^0.17.5",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2"
  }
}
