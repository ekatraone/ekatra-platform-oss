{
  "name": "@ekatra/database",
  "version": "1.0.0",
  "description": "PostgreSQL database client and schema for Ekatra",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "build": "tsc && node scripts/copy-migrations.mjs",
    "dev": "tsc -w",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "migrate": "node --import tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js"
  },
  "dependencies": {
    "ioredis": "^5.3.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}
