# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis (Optional - not currently used)
REDIS_URL=redis://localhost:6379

# =============================================================================
# WHATSAPP CLOUD API CONFIGURATION (Meta Business)
# =============================================================================
# Get these values from: https://developers.facebook.com/apps/
# Your App > WhatsApp > API Setup

# Temporary Access Token (expires in 24 hours - use for testing)
# For production, generate a permanent token via System User in Business Settings
META_ACCESS_TOKEN=EAAxxxxxxx

# Phone Number ID (found in WhatsApp > API Setup)
META_PHONE_NUMBER_ID=123456789012345

# WhatsApp Business Account ID
META_BUSINESS_ACCOUNT_ID=987654321098765

# Webhook Verification Token (set this to any random string, then use same in Meta dashboard)
META_WEBHOOK_VERIFY_TOKEN=your_random_verify_token_change_me

# App Secret (found in App Settings > Basic)
META_APP_SECRET=your_app_secret

# WhatsApp API Version
WHATSAPP_API_VERSION=v21.0

# =============================================================================
# AZURE OPENAI CONFIGURATION
# =============================================================================
# Azure OpenAI Service Configuration (from working setup)
AZURE_OPENAI_ENDPOINT=https://aeka-mf7uw5hr-swedencentral.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_LLM_MODEL=gpt-4o
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Azure OpenAI Assistants API (for RAG/vector search)
AZURE_OPENAI_ASSISTANT_ID=your_assistant_id
AZURE_OPENAI_VECTOR_STORE_ID=your_vector_store_id

# Azure OpenAI Whisper (for voice transcription)
AZURE_OPENAI_WHISPER_MODEL=whisper

# Azure Llama
AZURE_LLAMA_ENDPOINT=https://your-llama.inference.ai.azure.com/
AZURE_LLAMA_API_KEY=your_llama_key

# OpenAI (for DALL-E, Whisper)
OPENAI_API_KEY=sk-xxxxxxxx

# Anthropic (fallback)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Google AI (Gemini - optional)
GOOGLE_API_KEY=

# Azure Speech (TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ElevenLabs (TTS fallback)
ELEVENLABS_API_KEY=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=

# Server
PORT=3001
NODE_ENV=development

# Messaging provider: twilio | cloudapi | mock
# Use mock for web E2E testing without WhatsApp send costs.
MESSAGING_PROVIDER=mock

# OTP provider: firebase | mock
OTP_PROVIDER=firebase

# Firebase Admin (for OTP token verification in backend)
# Option A: full JSON on one line (escaped newlines)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: rely on GOOGLE_APPLICATION_CREDENTIALS + project id
FIREBASE_PROJECT_ID=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
