# Ekatra platform configuration.
# Copy to .env and fill in real values. Never commit .env or put real values here.
# Variables marked (optional) have safe defaults or enable an optional feature.

# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Allowed browser origin for the admin dashboard
FRONTEND_URL=http://localhost:8080
# Public origin of this API, used for provider callbacks and certificate links
WEBHOOK_BASE_URL=http://localhost:3000
# (optional) Public origin used when rendering media and links
PUBLIC_BASE_URL=
BACKEND_PUBLIC_URL=
# (optional) Number of reverse proxies in front of the API (Railway needs 2 when behind its edge)
TRUST_PROXY_HOPS=1

# --- Data ---------------------------------------------------------------
# Postgres with the pgvector extension
DATABASE_URL=postgresql://ekatra:ekatra_dev_password@localhost:5432/ekatra
# (optional) true only for an isolated local Postgres without TLS
DATABASE_DISABLE_SSL=false
REDIS_URL=redis://localhost:6379

# --- Auth ---------------------------------------------------------------
# Random string, 32+ characters in production
JWT_SECRET=
# Guards the one-time POST /api/auth/seed that creates the first admin
ADMIN_SEED_KEY=

# --- WhatsApp -----------------------------------------------------------
# cloudapi or twilio. If unset, twilio is used when Twilio credentials exist, else cloudapi.
WHATSAPP_PROVIDER=cloudapi

# Meta WhatsApp Cloud API (WHATSAPP_PROVIDER=cloudapi)
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
# (optional) Retry interval for stored webhook receipts, in milliseconds
WEBHOOK_RECOVERY_INTERVAL_MS=15000

# Twilio (WHATSAPP_PROVIDER=twilio, and WhatsApp OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# --- Telegram (optional) ------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# true to poll instead of using webhooks (local development)
TELEGRAM_POLLING=false

# --- Learner sign-in (Android apps) --------------------------------------
# firebase (default) or the provider your deployment uses
OTP_PROVIDER=firebase
# Firebase Admin credentials as a single-line JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
# (optional, demos only) allow joining with an invite code
ALLOW_TESTER_JOIN=false
DEMO_INVITE_CODE=

# --- AI: configure at least one provider ---------------------------------
# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MINI_DEPLOYMENT=gpt-5-mini
AZURE_ROUTER_DEPLOYMENT=model-router
AZURE_IMAGE_DEPLOYMENT=gpt-image-1
AZURE_TRANSCRIBE_DEPLOYMENT=gpt-4o-mini-transcribe
AZURE_VIDEO_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
AZURE_OPENAI_WHISPER_MODEL=whisper
AZURE_OPENAI_LLM_MODEL=
AZURE_OPENAI_ASSISTANT_ID=
AZURE_OPENAI_VECTOR_STORE_ID=
# Azure Speech (text to speech)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Claude through Azure AI Foundry
AZURE_ANTHROPIC_ENDPOINT=https://<your-resource>.services.ai.azure.com/anthropic
AZURE_ANTHROPIC_API_KEY=
AZURE_ANTHROPIC_MODEL=claude-sonnet-4-5
AZURE_ANTHROPIC_MODEL_MINI=
# Direct provider keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Meta model API
META_MODEL_API_BASE_URL=
META_MODEL_ID=
META_IMAGE_MODEL_ID=
MODEL_API_KEY=

# --- Course generation (optional) ----------------------------------------
COURSE_SIZE=
COURSE_IMAGES=
# 1 to skip the post-course feedback WhatsApp Flow for senders that cannot show it
DISABLE_FEEDBACK_FLOW=

# --- Observability (optional) --------------------------------------------
SENTRY_DSN=
ALERT_WEBHOOK_URL=

# --- Tests ---------------------------------------------------------------
TEST_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/postgres
